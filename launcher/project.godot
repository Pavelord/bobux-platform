; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bobux Launcher"
run/main_scene="res://scenes/launcher.tscn"
config/features=PackedStringArray("4.6")
boot_splash/bg_color=Color(0.07, 0.12, 0.16, 1)
boot_splash/show_image=false
config/icon="res://assets/branding/bobux_app_icon.png"

[display]

window/size/viewport_width=760
window/size/viewport_height=430
window/size/resizable=false

[launcher]

manifest_url="http://109.71.245.162/launcher/latest.json"
manifest_fallback_urls=PackedStringArray("http://109.71.245.162/downloads/latest.json", "https://raw.githubusercontent.com/Pavelord/game/main/launcher/latest.json")
install_folder_name="Bobux"
game_folder_name="Game"
game_executable="Bobux.exe"
version="0.1.12"
build=14
