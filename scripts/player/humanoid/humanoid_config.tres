source_refs = {
"Humanoid.JumpPowerVelocityScale": "Least-squares fit to all six actual Studio run02 JumpPower cases (powers 50/70; gravity 196.2/98.1/50), jointly minimizing relative apex-height and maximum observed velocity error at 60Hz. Engineering ballistic approximation, not an exact Roblox impulse formula. See docs/ROBLOX_HUMANOID_EMPIRICAL_RU.md.",
"MoveTo.TimeoutSeconds": "https://create.roblox.com/docs/reference/engine/classes/Humanoid#MoveTo (8-second timeout)",
"Network.MoveToAckGraceSeconds": "Bobux transport allowance for a client's timeout/completion acknowledgement; engineering policy, not Roblox movement physics.",
"WalkSpeed": "https://create.roblox.com/docs/reference/engine/classes/Humanoid#WalkSpeed (default 16 studs/s)",
"JumpPower": "https://create.roblox.com/docs/reference/engine/classes/Humanoid#JumpPower (default 50)",
"Humanoid.JumpHeight": "https://create.roblox.com/docs/reference/engine/classes/Humanoid#JumpHeight (default 7.2); fresh Humanoid getter also recorded in Studio run02. The motor's sqrt(2*g*h) conversion is an engineering approximation.",
"Gravity": "https://create.roblox.com/docs/reference/engine/classes/Workspace#Gravity (default 196.2 studs/s²; live map value overrides this fallback)",
"CollisionType": "Existing Bobux OuterBox/InnerBox collision policy; the internal Roblox Humanoid collision solver and shapes are not measured.",
"GroundSensor.SearchDistance": "Existing Bobux ground-probe reach in studs; no exact Roblox Humanoid sensor-distance claim.",
"ClimbSensor.SearchDistance": "Existing Bobux climb-probe reach in studs; automatic Roblox truss-detection reach was not measured.",
"R6.Head.Size": "Roblox Studio R6 part dump: .codex-tmp/roblox_humanoid_experiments/studio_run_01.empirical.json r6_parts[0].Head.size=[2,1,1]. API proxy dimensions only; original rounded Bobux visual mesh is preserved.",
"R6.InnerBox.Head.Size": "Reuse measured R6 Head Part.Size for the Bobux inner collision proxy; Roblox CollisionType internal shape is not measured.",
"Swimming.MoveSpeedFactor": "https://create.roblox.com/docs/reference/engine/classes/Humanoid#WalkSpeed (87.5% of WalkSpeed while swimming)",
"ClimbController.MoveSpeedFactor": "https://create.roblox.com/docs/reference/engine/classes/Humanoid#WalkSpeed (70% of WalkSpeed while climbing)",
"State.LandedMinimumSeconds": "Roblox Studio R6 run01: 10 drop samples; simulation median 0.0333333s, observed range about 0.02917–0.04583s (wall 32–51ms). Two fixed 60Hz Bobux physics steps approximate that measured median, not an exact universal Roblox constant. See docs/ROBLOX_HUMANOID_EMPIRICAL_RU.md."
}
