static func resolve(value: Variant) -> Color:
	if value is Color:
		return value
	var key := str(value).strip_edges().to_lower()
	var id: int = int(value) if value is int or value is float or key.is_valid_int() else int(NAMES.get(key, 194))
	return COLORS.get(id, COLORS[194])
