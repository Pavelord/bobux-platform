* text=auto
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.js text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
tools/patches/*.patch text eol=lf -whitespace

# Keep large authored 3D/map assets out of normal Git object storage.
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.rbxl filter=lfs diff=lfs merge=lfs -text
*.rbxlx filter=lfs diff=lfs merge=lfs -text
