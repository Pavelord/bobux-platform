PORT=3000
PUBLIC_BASE_URL=http://109.71.245.162
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SUPERUSER_EMAIL=admin@bobux.local
POCKETBASE_SUPERUSER_PASSWORD=change-me
POCKETBASE_DATA_DIR=/opt/pocketbase/pb_data
POCKETBASE_BIN=/opt/pocketbase/pocketbase
STORAGE_DIR=/var/www/bobux/storage
BOBUX_SERVER_HEARTBEAT_TOKEN=change-me
BOBUX_AI_API_KEY=replace_with_server_only_ai_key
BOBUX_AI_PROVIDER=auto
BOBUX_AI_FOLDER_ID=replace_with_yandex_cloud_folder_id
BOBUX_AI_MODEL=
BOBUX_AI_BASE_URL=
# Boblox: Node 22.13+. Keep credentials only on the API server.
BOBLOX_ENABLED=false
BOBLOX_DATABASE_PATH=/var/lib/bobux/boblox.sqlite
BOBLOX_PAYMENT_MODE=off
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BOBLOX_RETURN_URL=
# external: merchant handles receipts; yookassa: configured receipt integration.
BOBLOX_RECEIPT_MODE=
BOBLOX_VAT_CODE=1
BOBLOX_SALES_APPROVED=false
BOBLOX_TERMS_URL=
BOBLOX_SUPPORT_URL=

# Private database: never put it inside public storage.
BOBUX_SOCIAL_DB=/opt/bobux-api/data/social.sqlite
