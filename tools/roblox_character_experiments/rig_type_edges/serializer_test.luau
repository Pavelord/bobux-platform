-- Executes our telemetry helpers only. This does not simulate native coercion.
local Common=require("./common")
local count=0
local function check(value,message)assert(value,message);count+=1 end
check(Common.safe(false).value==false and Common.safe(false).type=="boolean","false preserved")
check(Common.safe(true).value==true,"true preserved")
check(Common.safe(0).value==0,"zero preserved")
check(Common.safe("").value=="","empty string preserved")
check(Common.safe(nil).is_nil==true,"nil tagged")
check(Common.safe(0/0).special=="nan" and Common.safe(0/0).value==nil,"NaN tagged, no JSON numeric NaN")
check(Common.safe(math.huge).special=="positive_inf" and Common.safe(math.huge).value==nil,"positive infinity tagged")
check(Common.safe(-math.huge).special=="negative_inf" and Common.safe(-math.huge).value==nil,"negative infinity tagged")
check(Common.safe({}).empty==true,"empty table observed without recursive conversion")
local cycle={};cycle.self=cycle
check(Common.safe(cycle).empty==false,"table serializer never recurses into a cycle")
local tuple=Common.tuple(table.pack(false,nil,0,nil))
check(tuple.count==4 and #tuple.values==4 and tuple.values[1].value==false and tuple.values[4].is_nil==true,"tuple arity/trailing nil preserved")
local getterFalse=Common.getter({RigType=false})
check(getterFalse.ok and getterFalse.value.value==false,"successful false getter is not failure")
local getterNil=Common.getter({})
check(getterNil.ok and getterNil.value.is_nil,"successful nil getter is not failure")
local getterError=Common.getter(setmetatable({},{__index=function()error("intentional own getter error")end}))
check(getterError.ok==false and string.find(getterError.reason,"intentional own getter error",1,true)~=nil,"getter error tagged separately")
local assigned={};local sink=setmetatable({},{__newindex=function(_,key,value)table.insert(assigned,{key=key,value=Common.safe(value)})end})
local setterFalse=Common.setter(sink,false);local setterNil=Common.setter(sink,nil)
check(setterFalse.ok and setterFalse.returns.count==0 and setterNil.ok and setterNil.returns.count==0,"setter success has zero returns")
check(assigned[1].value.value==false and assigned[2].value.is_nil,"setter passes false/nil without substitution")
local setterError=Common.setter(setmetatable({},{__newindex=function()error("intentional own setter error")end}),true)
check(setterError.ok==false and string.find(setterError.error,"intentional own setter error",1,true)~=nil,"setter failure is an observed result")
local ownR6={ok=true,value={type="EnumItem",EnumType="HumanoidRigType",Name="R6",Value=0}}
check(Common.matchesRig(ownR6,"R6"),"controlled-baseline tag validator accepts exact own schema")
check(not Common.matchesRig({ok=true,value={type="EnumItem",EnumType="CameraType",Name="R6",Value=0}},"R6"),"baseline tag validator rejects another domain")
check(not Common.matchesRig({ok=true,value={type="EnumItem",EnumType="HumanoidRigType",Name="unknown"}},"unknown"),"unregistered baseline name cannot match absent numeric ID")
print("RIG_TYPE_SERIALIZER_TEST PASS "..count.." own-data assertions; native coercion NOT_RUN")
